# Copy this file to .env and enter credentials from each provider's developer console.
# Never commit .env or share client secrets in chat.

# Google OAuth client configured as a Desktop app. Enable Gmail API and add test users
# while the consent screen is in Testing. Gmail access is read-only.
GOOGLE_CLIENT_ID=
# Optional for Google Desktop OAuth clients.
GOOGLE_CLIENT_SECRET=

# Slack app: enable Sign in with Slack, enable PKCE, and register this desktop callback.
# PKCE makes Slack a public client; SLACK_CLIENT_SECRET is not used by this flow.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:43821/omnidesk/oauth/callback

# LinkedIn app: enable Sign In with LinkedIn using OpenID Connect and register this URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ClickUp OAuth app: register this HTTPS Redirect URL in the app settings.
CLICKUP_CLIENT_ID=
CLICKUP_CLIENT_SECRET=

OAUTH_REDIRECT_URI=https://localhost/omnidesk/oauth/callback
